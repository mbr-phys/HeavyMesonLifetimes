<?xml version="1.0"?>
<!-- FermionFlow_Lifetimes: 2pts, two-quark HQE 3pts, dim-6 four-quark 3pts and dim-7 DeltaB=2, for pseudoscalar mesons.
     With saveWalls = 1 it also saves the unflowed wall propagators for FermionFlow_Eyes (run/input_eyes.xml, which must
     repeat runId, configPar, the quark names, smearPar, flowPar and wallStem/wallIo32 of this file). -->
<grid>
    <runPar>
        <runId>test</runId>
        <appDb>Schedule.db</appDb>
        <restore>false</restore>
        <scheduler>naive</scheduler>
        <flowChaining>step</flowChaining> <!-- step or interval -->
        <eyes>0</eyes>                    <!-- 1: dim-6 DeltaB=0 eyes and condensates (stochasticPar) in this run instead of FermionFlow_Eyes -->
        <saveWalls>1</saveWalls>          <!-- 1: save the unflowed wall propagators for FermionFlow_Eyes -->
        <wallStem>walls</wallStem>        <!-- directory of the saved wall propagators -->
        <wallIo32>1</wallIo32>            <!-- 1: wall propagators on disk in single precision -->
    </runPar>
    <configPar>
        <fileStem>/path/to/ckpoint_lat</fileStem> 
        <begin>280</begin>
        <end>281</end> <!-- must be gtr than final config to be used -->
        <step>40</step>
        <source_loc>0 21 23 19</source_loc> 
        <sources>
            <elem>0</elem>
            <elem>32</elem>
        </sources>
        <deltaTs>
            <elem>32</elem>
        </deltaTs>
        <Tmax>64</Tmax>
    </configPar>
    <hdwfPar>
        <quark>b</quark>
        <mass>0.45</mass>
        <Ls>12</Ls>
        <M5>1.0</M5>
        <b>1.5</b>
        <c>0.5</c>
        <residual>1.0e-18</residual>
        <maxiter>100000</maxiter>
        <maxiterIn>100000</maxiterIn>
        <maxiterOut>10</maxiterOut>
        <prop>none</prop>
    </hdwfPar>
    <sdwfPar>
        <quark>s</quark>
        <mass>0.02477</mass>
        <Ls>16</Ls>
        <M5>1.8</M5>
        <residual>1.0e-08</residual>
        <maxiter>10000</maxiter>
        <maxiterIn>100000</maxiterIn>
        <maxiterOut>10</maxiterOut>
        <prop>none</prop>
    </sdwfPar>
    <ldwfPar> <!-- placeholder values: set the light-quark parameters of the ensemble -->
        <quark>l</quark>
        <mass>0.005</mass>
        <Ls>16</Ls>
        <M5>1.8</M5>
        <residual>1.0e-08</residual>
        <maxiter>10000</maxiter>
        <maxiterIn>100000</maxiterIn>
        <maxiterOut>10</maxiterOut>
        <prop>none</prop>
    </ldwfPar>
    <mesonPar>
        <file_name>ApplicationTest</file_name>
        <!-- <gamma_src></gamma_src>
        <gamma_snk></gamma_snk>-->
        <!-- must contain (Gamma5 J) and (GammaTGamma5 J) for every probe J: flowed P and A0 for PCAC and the mass ratios -->
        <gamma_src>Gamma5 Gamma5 GammaTGamma5 GammaTGamma5 GammaX GammaY GammaZ GammaT</gamma_src>
        <gamma_snk>Gamma5 GammaTGamma5 Gamma5 GammaTGamma5 GammaX GammaY GammaZ GammaT</gamma_snk>
        <light>1</light>
        <rhq_impr>no</rhq_impr>
        <n2_min>0</n2_min>
        <n2_max>0</n2_max>
        <ss>1</ss>
        <moms>all</moms>
    </mesonPar>
    <flowPar>
        <output></output>
        <action>Wilson</action>
        <steps>10</steps>
        <step_size>0.01</step_size>
        <meas_interval>10</meas_interval>
        <Tcoarsen>9.01</Tcoarsen>
        <maxTau></maxTau>
        <bc>-1</bc>
    </flowPar>
    <stoutPar>
        <steps>3</steps>
        <rho>0.1</rho>
        <orthog></orthog>
    </stoutPar>
    <smearPar>
        <smear>1</smear>
        <width>6.5</width>
        <iterations>100</iterations>
        <orthog>3</orthog>
    </smearPar>
    <hqePar>
        <probeGammas>Gamma5</probeGammas> <!-- Gamma5 and/or GammaTGamma5 -->
        <vectorGammas>none</vectorGammas> <!-- B* 3pts: none, or a subset of GammaX GammaY GammaZ (each needs the 2pt pair (g g)) -->
        <twoQuark>true</twoQuark>
        <vertices></vertices>             <!-- empty = "all ops": 16 gammas + HQE operators, incl. the chirality-even g* mixing partners -->
        <dim7>true</dim7>
        <gammaPairs></gammaPairs>         <!-- dim-7 DeltaB=2 (WeakNonEye3ptDeriv) gamma pairs; empty = diag (16 G x G) -->
        <atTau0>true</atTau0>
    </hqePar>
    <stochasticPar> <!-- read only if runPar.eyes = 1; FermionFlow_Eyes reads its own copy (run/input_eyes.xml) -->
        <nSrcs>1</nSrcs>
        <nsparse>2</nsparse>              <!-- nSrcs*nsparse^4 noise components, one 12-column solve each per loop flavour -->
        <c_fl>0.0</c_fl>                  <!-- scalar condensate improvement; 0 for DWF -->
        <eyeGammaPairs>all</eyeGammaPairs> <!-- WeakEye3pt gamma pairs: diag, all, or "(G1 G2)..."; all for the penguin-type operators -->
    </stochasticPar>
</grid>
