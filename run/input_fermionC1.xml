        <begin>0</begin>
        <end>1</end> <!-- must be gtr than final config to be used -->
        <step>10</step>
        <source_loc>0 0 0 0</source_loc> 
        <sources>
            <elem>0</elem>
            <elem>16</elem>
            <elem>32</elem>
            <elem>48</elem>
        </sources>
        <deltaTs>
            <elem>28</elem>
        </deltaTs>
        <Tmax>64</Tmax>
    </configPar>
    <mdwfPar>
        <quark>
            <elem>s035</elem>
            <elem>s047</elem>
        </quark>
        <mass>
            <elem>0.035</elem>
            <elem>0.047</elem>
        </mass>
        <Ls>12</Ls>
        <M5>1.0</M5>
        <b>1.5</b>
        <c>0.5</c>
        <residual>1.0e-16</residual>
        <maxiter>100000</maxiter>
        <maxiterIn>100000</maxiterIn>
        <maxiterOut>10</maxiterOut>
        <prop>none</prop>
        <mixed>0</mixed>
    </mdwfPar>
    <mesonPar>
        <file_name>FlowTest</file_name>
        <gamma_src></gamma_src>
        <gamma_snk></gamma_snk>
        <!-- <gamma_src>Gamma5 Gamma5 GammaTGamma5 GammaTGamma5 GammaX GammaY GammaZ GammaT</gamma_src>
        <gamma_snk>Gamma5 GammaTGamma5 Gamma5 GammaTGamma5 GammaX GammaY GammaZ GammaT</gamma_snk>-->
    </mesonPar>
    <flowPar>
        <output></output>
        <action>Wilson</action>
        <steps>800</steps>
        <step_size>0.01</step_size>
        <meas_interval>10</meas_interval>
        <Tcoarsen>9.01</Tcoarsen>
        <maxTau></maxTau>
        <bc>-1</bc>
        <stout>1</stout>
    </flowPar>
    <stoutPar>
        <steps>3</steps>
        <rho>0.1</rho>
        <orthog></orthog>
    </stoutPar>
    <smearPar>
        <smear>0</smear>
        <width>4.5</width>
        <iterations>200</iterations>
        <orthog>3</orthog>
    </smearPar>
